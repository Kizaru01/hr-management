// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  hr
  employee
}

enum UserStatus {
  pending
  active
  suspended
  disabled
}

enum LeaveType {
  vacation
  sick
  emergency
  maternity
  paternity
  unpaid
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum AnnouncementAudience {
  company
  department
  branch
}

enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum NotificationType {
  leave
  document
  announcement
  performance_review
  system
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  role         UserRole   @default(employee)
  status       UserStatus @default(pending)
  isActive     Boolean    @default(false)

  notifications           Notification[]
  performanceReviewsGiven PerformanceReview[]
  uploadedDocuments       EmployeeDocument[]
  announcements           Announcement[]
  auditLogs               AuditLog[]

  activationTokenHash String?
  activationExpiresAt DateTime?

  lastLoginAt DateTime?

  employee Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String @id @default(cuid())
  employeeNumber String @unique

  firstName  String
  middleName String?
  lastName   String
  email      String  @unique

  phoneNumber String?
  avatar      String?

  birthDate DateTime? @db.Date
  gender    String?

  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?

  hireDate          DateTime
  employmentType    String
  employmentStatus  String    @default("active")
  terminationDate   DateTime? @db.Date
  terminationReason String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  managerId    String?
  manager      Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates Employee[] @relation("EmployeeManager")

  performanceReviews PerformanceReview[]
  documents          EmployeeDocument[]
  leaveRequests      LeaveRequest[]
  attendances        Attendance[]
  shiftAssignments   EmployeeShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
}

model Department {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String
  nameKey     String     @unique
  description String?
  isActive    Boolean    @default(true)
  positions   Position[]
  employees   Employee[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
}

model Position {
  id          String  @id @default(cuid())
  name        String
  description String?
  salary      Decimal @db.Decimal(12, 2)
  allowance   Decimal @default(0) @db.Decimal(12, 2)
  isActive    Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  employees    Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, name])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model Branch {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  address       String
  city          String?
  province      String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  allowedRadius Int?
  isActive      Boolean  @default(true)

  employees Employee[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]
}

model LeaveRequest {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  leaveType LeaveType

  reason String

  startDate DateTime
  endDate   DateTime

  status LeaveStatus @default(pending)

  approvedById String?
  approvedAt   DateTime?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  workDate DateTime @db.Date

  lateMinutes      Int @default(0)
  undertimeMinutes Int @default(0)

  checkInAt  DateTime
  checkOutAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate])
}

model Shift {
  id String @id @default(cuid())

  name      String @unique
  startTime String
  endTime   String

  isActive Boolean @default(true)

  employeeAssignments EmployeeShift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeShift {
  id String @id @default(cuid())

  workDays Weekday[]

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([shiftId])
  @@index([employeeId, effectiveFrom])
}

model Holiday {
  id String @id @default(cuid())

  name String
  date DateTime @db.Date

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([isActive])
}

model Announcement {
  id String @id @default(cuid())

  title   String
  content String

  audience AnnouncementAudience @default(company)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@index([isActive])
  @@index([departmentId])
  @@index([branchId])
}

model EmployeeDocument {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  title String
  type  String

  fileUrl String

  issuedAt  DateTime? @db.Date
  expiresAt DateTime? @db.Date

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([type])
  @@index([expiresAt])
}

model PerformanceReview {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  reviewDate DateTime @db.Date
  rating     Int

  strengths    String?
  improvements String?
  comments     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewerId])
  @@index([reviewDate])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title   String
  message String

  type NotificationType

  resourceId   String?
  resourceType String?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id])

  action     String
  entityType String
  entityId   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
